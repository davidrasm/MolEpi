	       parameter="@mutationRate"
	       scaleFactor="0.8" weight="1"/>

 
     <operator spec='ScaleOperator' id='kappaScaler'
	       parameter="@hky.kappa"
	       scaleFactor="0.8" weight="0.1">
     </operator>


 <!-- -->
